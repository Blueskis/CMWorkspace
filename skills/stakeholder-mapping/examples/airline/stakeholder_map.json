  "evidence": [
    {
      "id": "E1",
      "source": "ORG-01",
      "quote": "Org chart v2 (March 2026): Airline Operations sits over Flight Operations, Cabin Services, Crew Planning and Control, the Operations Control Centre and Airport Services. Engineering, Safety and Quality, Commercial, Finance, IT, HR and the Programme Office report to the Executive Committee.",
      "speaker": "",
      "attribution": "document"
    },
    {
      "id": "E2",
      "source": "INT-01",
      "quote": "Our rostering system is a 2009 spreadsheet engine with a front end. Every disruption we rebuild by hand.",
      "speaker": "Head of Crew Planning",
      "attribution": "testimony"
    },
    {
      "id": "E3",
      "source": "INT-01",
      "quote": "On a bad night the OCC duty managers just call crew on their mobiles and re-assign them. We find out from the payroll exceptions a week later.",
      "speaker": "Head of Crew Planning",
      "attribution": "testimony"
    },
    {
      "id": "E4",
      "source": "INT-01",
      "quote": "Before a new rule goes into the roster I ring Captain Lee. If the pilots' association won't live with it, the roster won't hold.",
      "speaker": "Head of Crew Planning",
      "attribution": "testimony"
    },
    {
      "id": "E18",
      "source": "INT-01",
      "quote": "Commercial change the schedule with two weeks' notice and tell Crew Planning last.",
      "speaker": "Head of Crew Planning",
      "attribution": "claim"
    },
    {
      "id": "E5",
      "source": "INT-02",
      "quote": "At 2am nobody reads a procedure. I phone the people I trust: the on-duty captain, the engineer on call, and Farid's night scheduler.",
      "speaker": "Senior duty manager, OCC",
      "attribution": "testimony"
    },
    {
      "id": "E6",
      "source": "INT-02",
      "quote": "The system has to tell me in seconds what a delay does to crew legality. If it takes a minute I will go back to the whiteboard.",
      "speaker": "Senior duty manager, OCC",
      "attribution": "testimony"
    },
    {
      "id": "E17",
      "source": "INT-02",
      "quote": "Engineering sign off the aircraft availability that we plan against. If the engineer on call says it's not ready, nothing I plan matters.",
      "speaker": "Senior duty manager, OCC",
      "attribution": "testimony"
    },
    {
      "id": "E7",
      "source": "INT-02",
      "quote": "The line pilots do what the Chief Pilot's office says about anything that changes their duty patterns.",
      "speaker": "Senior duty manager, OCC",
      "attribution": "claim"
    },
    {
      "id": "E8",
      "source": "INT-03",
      "quote": "Any change to how we track flight time limits must go to CAAS with a safety case. I call our CAAS flight operations inspector before we file.",
      "speaker": "Head of Safety and Quality",
      "attribution": "testimony"
    },
    {
      "id": "E9",
      "source": "INT-03",
      "quote": "Engineers ask Michael, our senior B1, before they trust a new system. He has more say than Engineering management does.",
      "speaker": "Head of Safety and Quality",
      "attribution": "claim"
    },
    {
      "id": "E10",
      "source": "INT-03",
      "quote": "I heard the pilots' association is going to ask for a ballot if the roster rules change.",
      "speaker": "Head of Safety and Quality",
      "attribution": "hearsay"
    },
    {
      "id": "E11",
      "source": "INT-04",
      "quote": "Vikram sponsors this. He messages me directly before every Exco and I brief him in the corridor, not in the steering meeting.",
      "speaker": "Programme Director",
      "attribution": "testimony"
    },
    {
      "id": "E12",
      "source": "INT-04",
      "quote": "Finance releases the vendor payments against milestones. Nothing has slipped yet, but the finance controller reads every invoice twice.",
      "speaker": "Programme Director",
      "attribution": "testimony"
    },
    {
      "id": "E13",
      "source": "INT-04",
      "quote": "The vendor's solution architect talks to our IT architect every day and I hear the outcomes second hand.",
      "speaker": "Programme Director",
      "attribution": "claim"
    },
    {
      "id": "E14",
      "source": "INT-04",
      "quote": "Neither union has been formally consulted. Raymond has asked twice for a seat on the design group.",
      "speaker": "Programme Director",
      "attribution": "testimony"
    },
    {
      "id": "E15",
      "source": "INT-05",
      "quote": "My pilots will accept a roster that is fair and predictable. They will not accept one that is clever but moves their days off.",
      "speaker": "Chief Pilot",
      "attribution": "testimony"
    },
    {
      "id": "E16",
      "source": "INT-05",
      "quote": "Cabin Services hear what their crew think from the cabin crew union before they hear it from the crew.",
      "speaker": "Chief Pilot",
      "attribution": "claim"
    }
  ]
}
