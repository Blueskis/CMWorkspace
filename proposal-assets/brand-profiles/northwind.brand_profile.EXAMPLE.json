      "hex": "#1a7a45"
    },
    "ink": {
      "name": "Northwind Deep Green",
      "hex": "#14432a"
    },
    "ink_soft": {
      "name": "Slate",
      "hex": "#3f4a52"
    },
    "muted": {
      "name": "Stone",
      "hex": "#7b858d"
    },
    "canvas": {
      "name": "White",
      "hex": "#ffffff"
    },
    "panel": {
      "name": "Oat",
      "hex": "#f4f1ea"
    },
    "rule": {
      "name": "Oat Dark",
      "hex": "#ddd6c7"
    },
