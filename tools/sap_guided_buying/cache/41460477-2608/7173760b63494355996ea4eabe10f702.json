{
 "title": "Switching Page Control Groups by Keyboard",
 "body": "<!DOCTYPE html\n  SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\" dir=\"ltr\"><head><title>Switching Page Control Groups by Keyboard</title><meta charset=\"utf-8\"><meta name=\"abstract\" content=\"Some pages have a multiple groups of controls, such as a left pane and a right pane.\"><meta name=\"description\" content=\"Some pages have a multiple groups of controls, such as a left pane and a right pane.\"><link rel=\"stylesheet\" type=\"text/css\" media=\"screen,projection\" href=\"/resource/css/style-v2.css\"><script type=\"text/javascript\" src=\"js/sap-strings.js\"></script></head><body class=\"en-us sap-light centered navigation-default enumeration-disabled collapsify-enabled\"><div id=\"d4h5-main-container\" class=\"container_12\" role=\"application\"><div id=\"d4h5-section-container\" class=\"grid_12\"><div id=\"d4h5-main-content\" class=\"grid_8 alpha omega\"><section><div class=\"page task  - topic-topic task-task \" id=\"loio7173760b63494355996ea4eabe10f702\"><h1 class=\"title topictitle1\">Switching Page Control Groups by Keyboard</h1><div class=\"body taskbody\"><p class=\"shortdesc\">Some pages have a multiple <em class=\"ph i\">groups</em> of controls, such as a left pane and a right\npane.</p>\n<section class=\"section procedure\"><span id=\"steps\" class=\"anchor\"></span><div class=\"ol steps tasklabel\"><h2 class=\"sectiontitle tasklabel\">Procedure</h2></div><ol class=\"ol steps\" id=\"loio7173760b63494355996ea4eabe10f702__steps_mlk_x23_3nb\"><li class=\"li step\">\n<span class=\"ph cmd\">To switch the focus to the next group with the keyboard, press <span class=\"ph keys keys\">\n<kbd class=\"keyword key key\">Ctrl</kbd>\n + <kbd class=\"keyword key key\">6</kbd>\n</span>.</span>\n</li><li class=\"li step\">\n<span class=\"ph cmd\">Continue pressing <span class=\"ph keys keys\">\n<kbd class=\"keyword key key\">Ctrl</kbd>\n + <kbd class=\"keyword key key\">6</kbd>\n</span> to loop back to the original group.</span>\n</li></ol></section>\n</div></div></section><div class=\"clear\"></div>\n</div></div></div></body></html>"
}